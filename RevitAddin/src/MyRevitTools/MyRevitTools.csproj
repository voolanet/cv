<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ek hi project, kai Revit versions.
    Build:  dotnet build -c Release -p:RevitVersion=2024
    Revit 2023/2024 -> .NET Framework 4.8
    Revit 2025+     -> .NET 8
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2023' Or '$(RevitVersion)' == '2024'">
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' &gt;= '2025'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>MyRevitTools</AssemblyName>
    <RootNamespace>MyRevitTools</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\R$(RevitVersion)\</OutputPath>
    <!-- Code mein  #if REVIT2024_OR_GREATER  jaisa use kar sakte hain -->
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2024'">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2025'">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &gt;= '2026'">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API reference assemblies (Revit ki DLL copy nahi hongi) -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\MyRevitTools.addin" Link="MyRevitTools.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Debug build par add-in seedha Revit ke Addins folder me copy ho jayega,
    taaki Revit restart karte hi naya code test ho.
  -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <AddinFiles Include="$(OutputPath)**\*.*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)MyRevitTools.addin" />
    </ItemGroup>
    <Copy SourceFiles="..\..\MyRevitTools.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Copy SourceFiles="@(AddinFiles)" DestinationFolder="$(RevitAddinsDir)MyRevitTools\%(RecursiveDir)" />
    <Message Importance="high" Text="Deployed to $(RevitAddinsDir)" />
  </Target>

</Project>
